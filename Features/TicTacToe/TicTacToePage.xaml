<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Features.TicTacToe.TicTacToePage"
             Title="Tic-Tac-Toe">

    <Grid
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16"
        Padding="16"
        BackgroundColor="#F5F5F5">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <!-- Header: title and score -->
            <Border
                StrokeShape="RoundRectangle 15"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12,8">
                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="TIC-TAC-TOE"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#333333"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding ScoreText}"
                        IsVisible="{Binding IsModeSelected}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#666666"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- CPU settings banner -->
            <Border
                IsVisible="{Binding IsCpuBannerVisible}"
                StrokeShape="RoundRectangle 15"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12,4">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="16">
                        <RadioButton Content="Easy" GroupName="Difficulty" Padding="0" Margin="0" TextColor="#333333" IsChecked="{Binding IsEasySelected, Mode=TwoWay}" />
                        <RadioButton Content="Medium" GroupName="Difficulty" Padding="0" Margin="0" TextColor="#333333" IsChecked="{Binding IsMediumSelected, Mode=TwoWay}" />
                        <RadioButton Content="Hard" GroupName="Difficulty" Padding="0" Margin="0" TextColor="#333333" IsChecked="{Binding IsHardSelected, Mode=TwoWay}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="16">
                        <RadioButton Content="X" GroupName="Side" Padding="0" Margin="0" TextColor="#1565C0" IsChecked="{Binding IsXSelected, Mode=TwoWay}" />
                        <RadioButton Content="O" GroupName="Side" Padding="0" Margin="0" TextColor="#C62828" IsChecked="{Binding IsOSelected, Mode=TwoWay}" />
                    </HorizontalStackLayout>
                    <Button
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Text="Confirm"
                        CornerRadius="10"
                        BackgroundColor="#FF9500"
                        TextColor="#333333"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        Command="{Binding StartCpuCommand}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Mode selection -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="14"
            VerticalOptions="Center"
            IsVisible="{Binding IsModeSelected, Converter={StaticResource InvertedBoolConverter}}">
            <Label
                Text="Choose a mode"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#333333"
                HorizontalTextAlignment="Center" />
            <Button
                Text="vs CPU"
                CornerRadius="10"
                BackgroundColor="#FF9500"
                TextColor="#333333"
                FontAttributes="Bold"
                Command="{Binding StartCpuCommand}" />
            <Button
                Text="vs Player"
                CornerRadius="10"
                BackgroundColor="#FF9500"
                TextColor="#333333"
                FontAttributes="Bold"
                Command="{Binding StartTwoPlayerCommand}" />
        </VerticalStackLayout>

        <!-- Board -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="14"
            VerticalOptions="Center"
            IsVisible="{Binding IsModeSelected}">

            <Label
                Text="{Binding StatusMessage}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#333333"
                HorizontalTextAlignment="Center" />

            <Grid
                RowDefinitions="*,*,*"
                ColumnDefinitions="*,*,*"
                RowSpacing="6"
                ColumnSpacing="6"
                Padding="6"
                WidthRequest="300"
                HeightRequest="300"
                HorizontalOptions="Center"
                BackgroundColor="#E0E0E0">

                <Border Grid.Row="0" Grid.Column="0" BindingContext="{Binding Cells[0]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BindingContext="{Binding Cells[1]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="0" Grid.Column="2" BindingContext="{Binding Cells[2]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BindingContext="{Binding Cells[3]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BindingContext="{Binding Cells[4]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="1" Grid.Column="2" BindingContext="{Binding Cells[5]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="2" Grid.Column="0" BindingContext="{Binding Cells[6]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="2" Grid.Column="1" BindingContext="{Binding Cells[7]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="2" Grid.Column="2" BindingContext="{Binding Cells[8]}" Background="{Binding CellBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.TapCellCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding Index}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Mark}" TextColor="{Binding MarkColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Result popup: fixed-height slot so the board does not shift -->
            <Grid HeightRequest="80">
                <Border
                    IsVisible="{Binding IsResultVisible}"
                    BackgroundColor="White"
                    Stroke="#FF9500"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15"
                    Padding="20,8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="12">
                        <Label
                            Text="{Binding ResultMessage}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#333333"
                            VerticalTextAlignment="Center" />
                        <Button
                            Text="Play Again"
                            CornerRadius="10"
                            BackgroundColor="#FF9500"
                            TextColor="#333333"
                            Command="{Binding NewRoundCommand}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Controls -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="10"
            IsVisible="{Binding IsModeSelected}">
            <Button
                Text="New Game"
                CornerRadius="10"
                BackgroundColor="#E8E8E8"
                TextColor="#333333"
                Command="{Binding NewRoundCommand}" />
            <Button
                Grid.Column="1"
                Text="Change Mode"
                CornerRadius="10"
                BackgroundColor="#E8E8E8"
                TextColor="#333333"
                Command="{Binding ChangeModeCommand}" />
        </Grid>
    </Grid>
</ContentPage>
