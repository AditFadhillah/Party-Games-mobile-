<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PartyGames.Models"
             xmlns:features="clr-namespace:PartyGames.Features.Main"
             x:Class="PartyGames.Features.Main.MainPage"
             Title="Party Games">

    <VerticalStackLayout
        Padding="20"
        Spacing="15"
        VerticalOptions="Fill"
        BackgroundColor="#2A2A2A">
        
        <!-- Title -->
        <Label
            Text="PARTY GAMES"
            FontSize="48"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            Margin="0,20,0,10"
            TextColor="White" />

        <!-- Subtitle -->
        <Label
            Text="Select a game to play"
            FontSize="14"
            TextColor="#CCCCCC"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,20" />

        <!-- Games List -->
        <StackLayout
            Spacing="15"
            VerticalOptions="Fill"
            Padding="0,20,0,20"
            BindableLayout.ItemsSource="{Binding Games}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:Game">
                    <Button
                        Text="{Binding Name}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type features:MainViewModel}}, Path=SelectGameCommand}"
                        CommandParameter="{Binding .}"
                        CornerRadius="15"
                        BackgroundColor="#FF9500"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        Padding="20,20" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </StackLayout>
    </VerticalStackLayout>

</ContentPage>

