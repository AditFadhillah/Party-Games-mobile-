<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Features.Blackjack.BlackjackPage"
             Title="Blackjack">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="CardTemplate">
                <Grid WidthRequest="56" HeightRequest="80">
                    <!-- Face down -->
                    <Border
                        IsVisible="{Binding IsFaceDown}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="White"
                        StrokeThickness="2"
                        BackgroundColor="#1F4E9A">
                        <Label
                            Text="?"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Face up -->
                    <Border
                        IsVisible="{Binding IsFaceDown, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="#B0B0B0"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="4">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Label
                                Text="{Binding RankText}"
                                TextColor="{Binding SuitColor}"
                                FontSize="13"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding SuitSymbol}"
                                TextColor="{Binding SuitColor}"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Row="2"
                                Text="{Binding RankText}"
                                TextColor="{Binding SuitColor}"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16"
        Padding="16"
        BackgroundColor="#2D5016">

        <!-- Header: title and money -->
        <Border
            Grid.Row="0"
            StrokeShape="RoundRectangle 10"
            Stroke="#FFD700"
            StrokeThickness="1"
            BackgroundColor="#1E3A0F"
            Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Text="BLACKJACK"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="{Binding Money, StringFormat='Money: {0}'}"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#FFD700"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Floating +/- amount that drifts down from the money banner -->
        <Label
            x:Name="MoneyChangeLabel"
            Grid.Row="0"
            Margin="0,0,14,0"
            FontSize="18"
            FontAttributes="Bold"
            Opacity="0"
            InputTransparent="True"
            HorizontalOptions="End"
            VerticalOptions="Center" />

        <!-- Table: dealer and player hands -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="14"
            VerticalOptions="Start">

            <!-- Result popup: fixed-height slot so the table does not shift -->
            <Grid HeightRequest="150">
                <Border
                    IsVisible="{Binding IsResultVisible}"
                    BackgroundColor="#FFD700"
                    Stroke="#FF9500"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15"
                    Padding="20,12"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label
                            Text="{Binding ResultMessage}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#333333"
                            HorizontalTextAlignment="Center" />
                        <Button
                            Text="Continue"
                            CornerRadius="10"
                            BackgroundColor="#2D5016"
                            TextColor="White"
                            Command="{Binding DismissResultCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label
                Text="{Binding DealerTotalText}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <HorizontalStackLayout
                x:Name="DealerRow"
                Spacing="6"
                HorizontalOptions="Center"
                BindableLayout.ItemsSource="{Binding DealerHand}"
                BindableLayout.ItemTemplate="{StaticResource CardTemplate}" />

            <Label
                Text="{Binding StatusMessage}"
                FontSize="15"
                TextColor="#FFD700"
                HorizontalTextAlignment="Center" />

            <HorizontalStackLayout
                x:Name="PlayerRow"
                Spacing="6"
                HorizontalOptions="Center"
                BindableLayout.ItemsSource="{Binding PlayerHand}"
                BindableLayout.ItemTemplate="{StaticResource CardTemplate}" />

            <Label
                Text="{Binding PlayerTotalText}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Controls -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button
                    Text="-"
                    FontSize="26"
                    FontAttributes="Bold"
                    WidthRequest="64"
                    HeightRequest="52"
                    Padding="0"
                    CornerRadius="10"
                    BackgroundColor="#E8E8E8"
                    TextColor="#333333"
                    IsVisible="{Binding IsBetting}"
                    Command="{Binding DecreaseBetCommand}" />
                <Label
                    Grid.Column="1"
                    Text="{Binding Bet, StringFormat='Bet: {0}'}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    IsVisible="{Binding ShowBetLabel}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
                <Button
                    Grid.Column="2"
                    Text="+"
                    FontSize="26"
                    FontAttributes="Bold"
                    WidthRequest="64"
                    HeightRequest="52"
                    Padding="0"
                    CornerRadius="10"
                    BackgroundColor="#E8E8E8"
                    TextColor="#333333"
                    IsVisible="{Binding IsBetting}"
                    Command="{Binding IncreaseBetCommand}" />
            </Grid>

            <Button
                Text="Deal"
                CornerRadius="10"
                BackgroundColor="#FFD700"
                TextColor="#333333"
                IsVisible="{Binding IsBetting}"
                Command="{Binding DealCommand}" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                IsVisible="{Binding IsRoundActive}">
                <Button
                    Text="Hit"
                    CornerRadius="10"
                    BackgroundColor="#E8E8E8"
                    TextColor="#333333"
                    Command="{Binding HitCommand}" />
                <Button
                    Grid.Column="1"
                    Text="Stand"
                    CornerRadius="10"
                    BackgroundColor="#E8E8E8"
                    TextColor="#333333"
                    Command="{Binding StandCommand}" />
            </Grid>

            <Button
                Text="Reset Money"
                IsVisible="{Binding IsOutOfMoney}"
                CornerRadius="10"
                BackgroundColor="#FFD700"
                TextColor="#333333"
                Command="{Binding ResetCommand}" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>

