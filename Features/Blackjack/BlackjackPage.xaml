<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Features.Blackjack.BlackjackPage"
             Title="Blackjack">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="RoundButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BackgroundColor" Value="#E8E8E8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#333333" />
                <Style.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="CardTemplate">
                <Grid WidthRequest="56" HeightRequest="80">
                    <!-- Face down -->
                    <Border
                        IsVisible="{Binding IsFaceDown}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="White"
                        StrokeThickness="2"
                        BackgroundColor="#1F4E9A">
                        <Label
                            Text="?"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Face up -->
                    <Border
                        IsVisible="{Binding IsFaceDown, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="#B0B0B0"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="4">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Label
                                Text="{Binding RankText}"
                                TextColor="{Binding SuitColor}"
                                FontSize="13"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding SuitSymbol}"
                                TextColor="{Binding SuitColor}"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Row="2"
                                Text="{Binding RankText}"
                                TextColor="{Binding SuitColor}"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="#2D5016">
    <Grid
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="16"
        Padding="16"
        BackgroundColor="#2D5016">

        <!-- Header: title and money -->
        <Border
            Grid.Row="0"
            StrokeShape="RoundRectangle 10"
            Stroke="#FFD700"
            StrokeThickness="1"
            BackgroundColor="#1E3A0F"
            Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Text="BLACKJACK"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="{Binding Money, StringFormat='Money: {0}'}"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#FFD700"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Floating +/- amount that drifts down from the money banner -->
        <Label
            x:Name="MoneyChangeLabel"
            Grid.Row="0"
            Margin="0,0,14,0"
            FontSize="18"
            FontAttributes="Bold"
            Opacity="0"
            InputTransparent="True"
            HorizontalOptions="End"
            VerticalOptions="Center" />

        <!-- Table: dealer and player hands -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="14">

            <Label
                Text="{Binding DealerTotalText}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <HorizontalStackLayout
                x:Name="DealerRow"
                Spacing="6"
                HorizontalOptions="Center"
                BindableLayout.ItemsSource="{Binding DealerHand}"
                BindableLayout.ItemTemplate="{StaticResource CardTemplate}" />

            <Label
                Text="{Binding StatusMessage}"
                FontSize="15"
                TextColor="#FFD700"
                HorizontalTextAlignment="Center" />

            <!-- One block per player hand; a split round shows several -->
            <VerticalStackLayout
                x:Name="PlayerRow"
                Spacing="10"
                HorizontalOptions="Center"
                BindableLayout.ItemsSource="{Binding Hands}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label
                                Text="{Binding Summary}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout
                                Spacing="6"
                                HorizontalOptions="Center"
                                BindableLayout.ItemsSource="{Binding Cards}"
                                BindableLayout.ItemTemplate="{StaticResource CardTemplate}" />
                            <Label
                                Text="{Binding BetText}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- Controls: one fixed-height cell, each state bottom-aligned so the table never shifts -->
        <Grid Grid.Row="2" HeightRequest="170" VerticalOptions="End">
        <VerticalStackLayout
            Spacing="10"
            VerticalOptions="End"
            IsVisible="{Binding IsBetting}">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button
                    Text="-"
                    FontSize="26"
                    FontAttributes="Bold"
                    WidthRequest="64"
                    HeightRequest="52"
                    Padding="0"
                    CornerRadius="10"
                    BackgroundColor="#E8E8E8"
                    TextColor="#333333"
                    IsVisible="{Binding IsBetting}"
                    Command="{Binding DecreaseBetCommand}" />
                <Label
                    Grid.Column="1"
                    Text="{Binding Bet, StringFormat='Bet: {0}'}"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsBetting}" />
                <Button
                    Grid.Column="2"
                    Text="+"
                    FontSize="26"
                    FontAttributes="Bold"
                    WidthRequest="64"
                    HeightRequest="52"
                    Padding="0"
                    CornerRadius="10"
                    BackgroundColor="#E8E8E8"
                    TextColor="#333333"
                    IsVisible="{Binding IsBetting}"
                    Command="{Binding IncreaseBetCommand}" />
            </Grid>

            <Button
                Text="Deal"
                CornerRadius="10"
                BackgroundColor="#FFD700"
                TextColor="#333333"
                IsVisible="{Binding IsBetting}"
                Command="{Binding DealCommand}" />
        </VerticalStackLayout>

            <Grid
                ColumnDefinitions="*,*,*,*"
                ColumnSpacing="8"
                VerticalOptions="End"
                IsVisible="{Binding IsRoundActive}">
                <Button
                    Text="Hit"
                    Style="{StaticResource RoundButtonStyle}"
                    Command="{Binding HitCommand}" />
                <Button
                    Grid.Column="1"
                    Text="Stand"
                    Style="{StaticResource RoundButtonStyle}"
                    Command="{Binding StandCommand}" />
                <Button
                    Grid.Column="2"
                    Text="Double"
                    FontSize="14"
                    Style="{StaticResource RoundButtonStyle}"
                    Command="{Binding DoubleDownCommand}" />
                <Button
                    Grid.Column="3"
                    Text="Split"
                    FontSize="14"
                    Style="{StaticResource RoundButtonStyle}"
                    Command="{Binding SplitCommand}" />
            </Grid>

            <Button
                Text="Reset Money"
                IsVisible="{Binding IsOutOfMoney}"
                CornerRadius="10"
                BackgroundColor="#FFD700"
                TextColor="#333333"
                VerticalOptions="End"
                Command="{Binding ResetCommand}" />

            <Border
                IsVisible="{Binding IsResultVisible}"
                BackgroundColor="#FFD700"
                Stroke="#FF9500"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 15"
                Padding="20,12"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label
                        Text="{Binding ResultMessage}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#333333"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="Continue"
                        CornerRadius="10"
                        BackgroundColor="#2D5016"
                        TextColor="White"
                        Command="{Binding DismissResultCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
    </ScrollView>

</ContentPage>

