<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PartyGames.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PartyGames"
    xmlns:views="clr-namespace:PartyGames.Views"
    Title="PartyGames"
    FlyoutBehavior="Disabled">

    <ShellContent Route="MainPage" ContentTemplate="{DataTemplate local:MainPage}" />
    <ShellContent Route="dice" ContentTemplate="{DataTemplate views:DiceGamePage}" />
    <ShellContent Route="coinflip" ContentTemplate="{DataTemplate views:CoinFlipPage}" />
    <ShellContent Route="blackjack" ContentTemplate="{DataTemplate views:BlackjackPage}" />

</Shell>

