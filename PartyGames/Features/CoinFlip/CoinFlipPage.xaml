<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Views.CoinFlipPage"
             Title="Coin Flip">

    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        VerticalOptions="FillAndExpand"
        BackgroundColor="#F5F5F5">

        <!-- Title -->
        <Label
            Text="🪙 COIN FLIP"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            TextColor="#333333" />

        <!-- Coin Display -->
        <Frame
            CornerRadius="15"
            Padding="40"
            BackgroundColor="White"
            BorderColor="#E0E0E0"
            HasShadow="True"
            HorizontalOptions="Center"
            WidthRequest="200"
            HeightRequest="200">
            <Label
                Text="{Binding CoinDisplay}"
                FontSize="80"
                TextColor="#4CAF50"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Frame>

        <!-- Result Message -->
        <Label
            Text="{Binding ResultMessage}"
            FontSize="18"
            TextColor="#333333"
            HorizontalTextAlignment="Center"
            FontAttributes="Bold" />

        <!-- Stats -->
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Frame
                CornerRadius="10"
                Padding="15"
                BackgroundColor="#E8F5E9"
                BorderColor="#4CAF50">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label
                        Text="Wins"
                        FontSize="12"
                        TextColor="#2E7D32"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding Wins}"
                        FontSize="24"
                        TextColor="#4CAF50"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Frame
                CornerRadius="10"
                Padding="15"
                BackgroundColor="#FFEBEE"
                BorderColor="#F44336">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label
                        Text="Losses"
                        FontSize="12"
                        TextColor="#C62828"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding Losses}"
                        FontSize="24"
                        TextColor="#F44336"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Frame
                CornerRadius="10"
                Padding="15"
                BackgroundColor="#E3F2FD"
                BorderColor="#2196F3">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label
                        Text="Streak"
                        FontSize="12"
                        TextColor="#1565C0"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding Streak}"
                        FontSize="24"
                        TextColor="#2196F3"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>
        </HorizontalStackLayout>

        <!-- Action Buttons -->
        <VerticalStackLayout Spacing="10">
            <Label
                Text="Make your prediction:"
                FontSize="14"
                TextColor="#666666"
                HorizontalTextAlignment="Center" />

            <HorizontalStackLayout Spacing="10">
                <Button
                    Text="👤 HEADS"
                    Command="{Binding FlipHeadsCommand}"
                    CornerRadius="12"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="15,12"
                    HorizontalOptions="FillAndExpand"
                    IsEnabled="{Binding IsFlipping, Converter={StaticResource InvertedBoolConverter}}" />

                <Button
                    Text="✓ TAILS"
                    Command="{Binding FlipTailsCommand}"
                    CornerRadius="12"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="15,12"
                    HorizontalOptions="FillAndExpand"
                    IsEnabled="{Binding IsFlipping, Converter={StaticResource InvertedBoolConverter}}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Spacer -->
        <BoxView HeightRequest="1" BackgroundColor="Transparent" VerticalOptions="FillAndExpand" />

        <!-- Back Button -->
        <Button
            Text="← Back"
            Command="{Binding BackCommand}"
            CornerRadius="10"
            BackgroundColor="#E8E8E8"
            TextColor="#333333"
            FontSize="14"
            Padding="20,10" />
    </VerticalStackLayout>

</ContentPage>

