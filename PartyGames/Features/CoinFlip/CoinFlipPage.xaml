<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Features.CoinFlip.CoinFlipPage"
             Title="Coin Flip">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20"
            BackgroundColor="#F5F5F5">

            <Label
                Text="COIN FLIP"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="#333333" />

            <Border
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="20">
                <Image
                    x:Name="Coin"
                    Source="{Binding CoinImage}"
                    Rotation="{Binding CoinRotation}"
                    WidthRequest="220"
                    HeightRequest="220"
                    Aspect="AspectFit"
                    HorizontalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding FlipCommand}"
                            Tapped="OnCoinTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Border>

            <Border
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Last Flips"
                        FontSize="12"
                        TextColor="#666666"
                        FontAttributes="Bold" />
                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        BindableLayout.ItemsSource="{Binding FlipHistory}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Image
                                    Source="{Binding}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Aspect="AspectFit"
                                    Margin="0,0,6,6" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

