<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Features.Blackjack.BlackjackPage"
             Title="Blackjack">

    <Grid
        RowDefinitions="Auto,*,Auto"
        RowSpacing="20"
        Padding="20"
        BackgroundColor="#2D5016">

        <!-- Title -->
        <Label
            Text="♠️ BLACKJACK ♠️"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            TextColor="White" />

        <!-- Coming Soon Message -->
        <Border
            Grid.Row="1"
            StrokeShape="RoundRectangle 15"
            Stroke="#FF9500"
            StrokeThickness="1"
            Padding="30"
            BackgroundColor="#FFD700"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                <Label
                    Text="🎴"
                    FontSize="48"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Blackjack Game"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#333333"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Coming Soon in Phase 2!"
                    FontSize="14"
                    TextColor="#666666"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Back Button -->
        <Button
            Grid.Row="2"
            Text="← Back to Games"
            CornerRadius="10"
            BackgroundColor="#E8E8E8"
            TextColor="#333333"
            FontSize="14"
            Padding="20,10" />
    </Grid>

</ContentPage>

