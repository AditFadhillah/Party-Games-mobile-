{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-windows",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "-f",
                "net10.0-windows10.0.19041.0",
                "-c",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false
            },
            "options": {
                "cwd": "${workspaceFolder}/PartyGames"
            }
        }
    ]
}
