<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Views.DiceGamePage"
             Title="Dice Roller">

    <ScrollView>
    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        VerticalOptions="FillAndExpand"
        BackgroundColor="#F5F5F5">

        <!-- Title -->
        <Label
            Text="DICE ROLLER"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            TextColor="#333333" />

        <!-- Die Type Selector -->
        <HorizontalStackLayout
            Spacing="6"
            HorizontalOptions="Center"
            BindableLayout.ItemsSource="{Binding DieTypes}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Button
                        Text="{Binding Name}"
                        Command="{Binding SelectCommand}"
                        BackgroundColor="{Binding BackgroundColor}"
                        TextColor="{Binding TextColor}"
                        CornerRadius="8"
                        Padding="0,4"
                        WidthRequest="40"
                        FontSize="13" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <!-- Dice Display -->
        <Frame
            CornerRadius="15"
            Padding="20"
            BackgroundColor="White"
            BorderColor="#E0E0E0"
            HasShadow="True">
            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                <!-- Dice Count Selector -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Button
                        Text="-"
                        Command="{Binding DecreaseDiceCommand}"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        Padding="0"
                        FontSize="24"
                        BackgroundColor="#E8E8E8"
                        TextColor="#333333" />
                    <Label
                        Text="{Binding DiceCount}"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#333333"
                        WidthRequest="50"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="+"
                        Command="{Binding IncreaseDiceCommand}"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        Padding="0"
                        FontSize="24"
                        BackgroundColor="#E8E8E8"
                        TextColor="#333333" />
                </HorizontalStackLayout>

                <!-- Individual Dice -->
                <FlexLayout
                    x:Name="DiceRow"
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="Center"
                    HorizontalOptions="Center"
                    BindableLayout.ItemsSource="{Binding Dice}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <GraphicsView
                                Drawable="{Binding Shape}"
                                WidthRequest="72"
                                HeightRequest="72"
                                Margin="1"
                                HorizontalOptions="Center" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Total -->
                <StackLayout HorizontalOptions="Center">
                    <Label
                        Text="Total:"
                        FontSize="16"
                        TextColor="#666666"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding Total}"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="#FF9500"
                        HorizontalOptions="Center" />
                </StackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Roll Button -->
        <Button
            x:Name="RollButton"
            Text="ROLL DICE"
            Command="{Binding RollCommand}"
            CornerRadius="15"
            BackgroundColor="#FF9500"
            TextColor="White"
            FontSize="16"
            FontAttributes="Bold"
            Padding="20,15"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Clicked="OnRollButtonClicked" />

        <!-- Stats Section -->
        <Frame
            CornerRadius="15"
            Padding="15"
            BackgroundColor="White"
            BorderColor="#E0E0E0"
            HasShadow="True">
            <HorizontalStackLayout Spacing="20">
                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label
                        Text="Best Roll"
                        FontSize="12"
                        TextColor="#666666"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding BestRoll}"
                        FontSize="20"
                        TextColor="#FF9500"
                        FontAttributes="Bold" />
                </VerticalStackLayout>

                <BoxView WidthRequest="1" BackgroundColor="#E0E0E0" />

                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label
                        Text="Last Rolls"
                        FontSize="12"
                        TextColor="#666666"
                        FontAttributes="Bold" />
                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        WidthRequest="250"
                        BindableLayout.ItemsSource="{Binding RollHistory}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,5,5"
                                    BackgroundColor="#FFE6CC"
                                    BorderColor="Transparent">
                                    <Label
                                        Text="{Binding}"
                                        FontSize="12"
                                        TextColor="#333333"
                                        FontAttributes="Bold" />
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Frame>
    </VerticalStackLayout>
    </ScrollView>

</ContentPage>

