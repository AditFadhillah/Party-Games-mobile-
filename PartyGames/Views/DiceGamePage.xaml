<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PartyGames.Views.DiceGamePage"
             Title="Dice Roller">

    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        VerticalOptions="FillAndExpand"
        BackgroundColor="#F5F5F5">

        <!-- Title -->
        <Label
            Text="🎲 DICE ROLLER"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            TextColor="#333333" />

        <!-- Dice Display -->
        <Frame
            CornerRadius="15"
            Padding="30"
            BackgroundColor="White"
            BorderColor="#E0E0E0"
            HasShadow="True">
            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                <!-- Dice Count Selector -->
                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Button
                        Text="-"
                        Command="{Binding DecreaseDiceCommand}"
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="25"
                        Padding="0"
                        FontSize="24"
                        BackgroundColor="#E8E8E8"
                        TextColor="#333333" />
                    <Label
                        Text="{Binding DiceCount}"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#333333"
                        WidthRequest="50"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="+"
                        Command="{Binding IncreaseDiceCommand}"
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="25"
                        Padding="0"
                        FontSize="24"
                        BackgroundColor="#E8E8E8"
                        TextColor="#333333" />
                </HorizontalStackLayout>

                <!-- Individual Dice -->
                <HorizontalStackLayout
                    x:Name="DiceRow"
                    Spacing="10"
                    HorizontalOptions="Center"
                    BindableLayout.ItemsSource="{Binding Dice}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                CornerRadius="10"
                                Padding="0"
                                BackgroundColor="#FFE6CC"
                                BorderColor="#FF9500"
                                WidthRequest="64"
                                HeightRequest="64"
                                HorizontalOptions="Center">
                                <Label
                                    Text="{Binding}"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    TextColor="#333333"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    VerticalTextAlignment="Center"
                                    HorizontalTextAlignment="Center" />
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <!-- Total -->
                <StackLayout HorizontalOptions="Center">
                    <Label
                        Text="Total:"
                        FontSize="16"
                        TextColor="#666666"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding Total}"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="#FF9500"
                        HorizontalOptions="Center" />
                </StackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Roll Button -->
        <Button
            x:Name="RollButton"
            Text="🎲 ROLL DICE"
            Command="{Binding RollCommand}"
            CornerRadius="15"
            BackgroundColor="#FF9500"
            TextColor="White"
            FontSize="16"
            FontAttributes="Bold"
            Padding="20,15"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Clicked="OnRollButtonClicked" />

        <!-- Stats Section -->
        <Frame
            CornerRadius="15"
            Padding="15"
            BackgroundColor="White"
            BorderColor="#E0E0E0"
            HasShadow="True">
            <HorizontalStackLayout Spacing="20">
                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label
                        Text="Best Roll"
                        FontSize="12"
                        TextColor="#666666"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding BestRoll}"
                        FontSize="20"
                        TextColor="#FF9500"
                        FontAttributes="Bold" />
                </VerticalStackLayout>

                <BoxView WidthRequest="1" BackgroundColor="#E0E0E0" />

                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label
                        Text="Last Rolls"
                        FontSize="12"
                        TextColor="#666666"
                        FontAttributes="Bold" />
                    <CollectionView
                        ItemsSource="{Binding RollHistory}"
                        HeightRequest="40">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Horizontal"
                                ItemSpacing="5" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    CornerRadius="8"
                                    Padding="8"
                                    BackgroundColor="#FFE6CC"
                                    BorderColor="Transparent">
                                    <Label
                                        Text="{Binding}"
                                        FontSize="12"
                                        TextColor="#333333"
                                        FontAttributes="Bold" />
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <!-- Spacer -->
        <BoxView HeightRequest="1" BackgroundColor="Transparent" />

        <!-- Back Button -->
        <Button
            Text="← Back"
            Command="{Binding BackCommand}"
            CornerRadius="10"
            BackgroundColor="#E8E8E8"
            TextColor="#333333"
            FontSize="14"
            Padding="20,10" />
    </VerticalStackLayout>

</ContentPage>

